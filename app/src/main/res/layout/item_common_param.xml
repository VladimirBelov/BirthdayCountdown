<!-- для "Фото" и "Даты" в секции "Общие" -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="8dp">

    <TextView
        android:id="@+id/common_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textSize="14sp"
        android:textColor="?attr/dialogTextColor" />

    <TextView
        android:id="@+id/common_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:textSize="13sp"
        android:textStyle="italic"
        android:clickable="true"
        android:focusable="true"
        android:textColor="?attr/dialogTextColor" />

    <ImageView
        android:id="@+id/common_settings_icon"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginStart="4dp"
        android:src="@android:drawable/ic_menu_preferences"
        android:contentDescription="@string/button_prefs"
        android:visibility="gone"
        android:background="?android:attr/selectableItemBackgroundBorderless" />

    <ImageView
        android:id="@+id/common_color_icon"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:src="@drawable/ic_menu_paste"
        android:contentDescription="@string/hint_Color"
        android:visibility="gone" />

</LinearLayout>