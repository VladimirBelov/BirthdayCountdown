<RadioGroup xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rg_desc_mode"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="16dp">

    <RadioButton
        android:id="@+id/rb_desc_inline"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/desc_setting_inline"
        android:textColor="?attr/dialogTextColor" />

    <RadioButton
        android:id="@+id/rb_desc_triangle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/desc_setting_triangle"
        android:textColor="?attr/dialogTextColor" />

    <RadioButton
        android:id="@+id/rb_desc_hidden"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/desc_setting_hidden"
        android:textColor="?attr/dialogTextColor" />
</RadioGroup>