<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical|start"
    android:orientation="vertical"
    android:padding="?attr/dialogPreferredPadding"
    android:background="?attr/dialogBackgroundColor">

    <LinearLayout
        android:id="@+id/caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingBottom="8dp">

        <ImageView
            android:id="@+id/icon"
            android:layout_width="32dip"
            android:layout_height="32dip"
            android:layout_marginEnd="8dip"
            android:contentDescription="@string/hint_AlertDialogIcon"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/title"
            style="?android:attr/windowTitleStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAlignment="viewStart"
            android:textColor="?attr/dialogTextColor" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/color_preview"
            android:layout_width="35dip"
            android:layout_height="35dip"
            android:layout_gravity="center"
            android:layout_marginEnd="20dp"
            android:scaleType="fitCenter"
            android:importantForAccessibility="no" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/color_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="?attr/dialogTextColor" />

            <EditText
                android:id="@+id/color_edit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:hint="@string/hint_Color"
                android:inputType="textNoSuggestions"
                android:maxLines="1"
                android:minHeight="48dp"
                android:importantForAutofill="no"
                android:textColor="?attr/dialogTextColor" />

        </LinearLayout>
    </LinearLayout>

    <!-- Цветовой спектр HSV -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp">

        <ImageView
            android:id="@+id/color_spectrum"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitXY"
            android:contentDescription="@string/hint_ColorSpectrum" />

        <!-- Маркер текущего цвета -->
        <View
            android:id="@+id/color_marker"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:background="@drawable/marker_circle"
            android:visibility="visible" />

    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="8dp">

        <TextView
            android:id="@+id/seek1_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="?attr/dialogTextColor" />

        <TextView
            android:id="@+id/seek1_progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="right"
            android:textColor="?attr/dialogTextColor" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageButton
            android:id="@+id/btnRedColorMinus"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/hint_Less"
            android:src="@drawable/ic_menu_sub"
            app:tint="?attr/colorAccent" />

        <SeekBar
            android:id="@+id/seekRedColor"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="-8dp"
            android:layout_marginEnd="-8dp"
            android:maxHeight="50dp"
            android:minHeight="50dp"
            android:thumbTintMode="src_in"
            android:max="255"/>

        <ImageButton
            android:id="@+id/btnRedColorPlus"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/hint_More"
            android:src="@android:drawable/ic_menu_add"
            app:tint="?attr/colorAccent" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="8dp">

        <TextView
            android:id="@+id/seek2_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="?attr/dialogTextColor" />

        <TextView
            android:id="@+id/seek2_progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="right"
            android:textColor="?attr/dialogTextColor" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageButton
            android:id="@+id/btnGreenColorMinus"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/hint_Less"
            android:src="@drawable/ic_menu_sub"
            app:tint="?attr/colorAccent" />

        <SeekBar
            android:id="@+id/seekGreenColor"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="-8dp"
            android:layout_marginEnd="-8dp"
            android:maxHeight="50dp"
            android:minHeight="50dp"
            android:thumbTintMode="src_in"
            android:max="255"/>

        <ImageButton
            android:id="@+id/btnGreenColorPlus"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/hint_More"
            android:src="@android:drawable/ic_menu_add"
            app:tint="?attr/colorAccent" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="8dp">

        <TextView
            android:id="@+id/seek3_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="?attr/dialogTextColor" />

        <TextView
            android:id="@+id/seek3_progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="right"
            android:textColor="?attr/dialogTextColor" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageButton
            android:id="@+id/btnBlueColorMinus"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/hint_Less"
            android:src="@drawable/ic_menu_sub"
            app:tint="?attr/colorAccent" />

        <SeekBar
            android:id="@+id/seekBlueColor"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="-8dp"
            android:layout_marginEnd="-8dp"
            android:maxHeight="50dp"
            android:minHeight="50dp"
            android:thumbTintMode="src_in"
            android:max="255"/>

        <ImageButton
            android:id="@+id/btnBlueColorPlus"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/hint_More"
            android:src="@android:drawable/ic_menu_add"
            app:tint="?attr/colorAccent" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="8dp">

        <TextView
            android:id="@+id/seek4_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="?attr/dialogTextColor" />

        <TextView
            android:id="@+id/seek4_progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="right"
            android:textColor="?attr/dialogTextColor" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageButton
            android:id="@+id/btnTransparencyMinus"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/hint_Less"
            android:src="@drawable/ic_menu_sub"
            app:tint="?attr/colorAccent" />

        <SeekBar
            android:id="@+id/seekTransparency"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="-8dp"
            android:layout_marginEnd="-8dp"
            android:maxHeight="50dp"
            android:minHeight="50dp"
            android:thumbTintMode="src_in"
            android:max="255"/>

        <ImageButton
            android:id="@+id/btnTransparencyPlus"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/hint_More"
            android:src="@android:drawable/ic_menu_add"
            app:tint="?attr/colorAccent" />
    </LinearLayout>

</LinearLayout>