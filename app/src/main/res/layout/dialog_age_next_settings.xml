<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <CheckBox
        android:id="@+id/cb_age_next_full"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/age_next_show_full"
        android:textColor="?attr/dialogTextColor" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/age_next_style_title"
        android:textStyle="bold"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp"
        android:textColor="?attr/dialogTextColor" />

    <RadioGroup
        android:id="@+id/rg_age_next_style"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <RadioButton
            android:id="@+id/rb_age_next_normal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/age_next_style_normal"
            android:textColor="?attr/dialogTextColor" />

        <RadioButton
            android:id="@+id/rb_age_next_bold"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/age_next_style_bold"
            android:textColor="?attr/dialogTextColor" />

        <RadioButton
            android:id="@+id/rb_age_next_shadow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/age_next_style_shadow"
            android:textColor="?attr/dialogTextColor" />

    </RadioGroup>

</LinearLayout>